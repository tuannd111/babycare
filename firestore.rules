rules_version = '2';

// Luật bảo mật cho Sổ Tay 180 Ngày Đầu.
// Mỗi gia đình là một tài liệu families/{fid}; chỉ thành viên mới đọc và ghi được dữ liệu của gia đình.
// Người mới vào gia đình bằng mã mời: invites/{mã} trỏ tới familyId.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(fid) {
      return signedIn() && request.auth.uid in get(/databases/$(db)/documents/families/$(fid)).data.members;
    }

    // Hồ sơ riêng: tên hiển thị và gia đình đang tham gia.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Mã mời: ai đăng nhập cũng tra được một mã cụ thể, nhưng không liệt kê được danh sách mã.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isMember(request.resource.data.familyId);
      allow delete: if isMember(resource.data.familyId);
    }

    match /families/{fid} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        // Người chưa là thành viên chỉ được tự thêm mình vào, và phải đưa đúng mã mời của gia đình này.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'joinCode'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members
            && get(/databases/$(db)/documents/invites/$(request.resource.data.joinCode)).data.familyId == fid)
      );

      // Nhật ký theo ngày (days/{YYYY-MM-DD}) và dữ liệu chung (state/main).
      match /{sub=**} {
        allow read, write: if isMember(fid);
      }
    }
  }
}
